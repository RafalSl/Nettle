{
  "expo": {
    "name": "Nettle",
    "slug": "nettle",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nettle",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nettle reads photos you choose to attach to your skin and nail entries. They stay on this device.",
          "cameraPermission": "Nettle uses the camera to photograph skin and nails for your diary. Photos stay on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
